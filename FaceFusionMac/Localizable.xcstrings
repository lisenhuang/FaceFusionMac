    "Higher keeps more of the source face; lower blends toward the original." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höher behält mehr vom Quellgesicht; niedriger blendet zum Original über."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más alto conserva más del rostro de origen; más bajo se mezcla con el original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus haut conserve davantage du visage source ; plus bas se rapproche de l’original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più alto mantiene di più del volto di origine; più basso si avvicina all'originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高くするほどソースの顔の特徴が強く残り、低くするほど元の顔になじみます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높일수록 소스 얼굴이 더 많이 남고, 낮출수록 원래 얼굴에 가깝게 섞입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores mais altos mantêm mais do rosto de origem; mais baixos aproximam do original."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调高会更多保留源人脸，调低则更接近原本的脸。"
