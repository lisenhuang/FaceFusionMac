    "Every file is verified against a checksum before use, and anything that does not match is discarded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Datei wird vor der Verwendung anhand einer Prüfsumme überprüft; alles, was nicht übereinstimmt, wird verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada archivo se verifica con una suma de comprobación antes de usarlo, y todo lo que no coincide se descarta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fichier est vérifié par une somme de contrôle avant d’être utilisé, et tout ce qui ne correspond pas est supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni file viene verificato con un checksum prima dell'uso e tutto ciò che non corrisponde viene scartato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada arquivo é verificado por checksum antes de ser usado, e tudo que não confere é descartado."
          }
        }
      }
    },
    "Everything here can be downloaded again. Removing it costs the wait, not the work — no face, video or setting is touched." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles hier lässt sich erneut laden. Entfernen kostet nur Wartezeit, nicht deine Arbeit — kein Gesicht, kein Video und keine Einstellung wird angerührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo esto se puede volver a descargar. Eliminarlo cuesta la espera, no el trabajo — no se toca ningún rostro, video ni ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui se trouve ici peut être téléchargé à nouveau. Le supprimer coûte du temps, pas du travail — aucun visage, aucune vidéo ni aucun réglage n’est touché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto quello che c'è qui può essere scaricato di nuovo. Rimuoverlo costa l'attesa, non il lavoro — nessun volto, video o impostazione viene toccato."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo aqui pode ser baixado de novo. Remover custa a espera, não o trabalho — nenhum rosto, vídeo ou ajuste é afetado."
          }
        }
      }
    },
