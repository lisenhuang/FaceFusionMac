    "System follows macOS. Choosing a language applies to Morphiqo and is remembered for the next launch." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt macOS. Eine gewählte Sprache gilt für Morphiqo und wird für den nächsten Start gemerkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "System follows macOS. Choosing a language applies to Morphiqo and is remembered for the next launch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción Sistema sigue el idioma de macOS. El idioma que elijas se aplica a Morphiqo y se recuerda para el próximo inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’option Système suit macOS. Le choix d’une langue s’applique à Morphiqo et est conservé au prochain lancement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue macOS. La lingua che scegli vale per Morphiqo e viene ricordata al prossimo avvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムは macOS に従います。言語を選択すると Morphiqo に適用され、次回の起動時にも保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템은 macOS 설정을 따릅니다. 언어를 선택하면 Morphiqo에 적용되며 다음 실행에도 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema acompanha o macOS. O idioma escolhido vale para o Morphiqo e é lembrado na próxima abertura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统选项跟随 macOS。选择语言后会应用于 Morphiqo，并在下次启动时保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統選項跟隨 macOS。選擇語言後會套用至 Morphiqo，並在下次啟動時保留。"
          }
        }
      }
    },
