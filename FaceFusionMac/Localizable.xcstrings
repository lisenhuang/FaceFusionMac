        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出し中です。完了するまでモデルは削除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기가 진행 중입니다. 완료될 때까지 모델을 제거할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
