    "Sharper results and steadier tracking. You can add these later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schärfere Ergebnisse und stabilere Verfolgung. Du kannst das später hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultados más nítidos y un seguimiento más estable. Puedes agregarlos después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des résultats plus nets et un suivi plus stable. Vous pourrez les ajouter plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risultati più nitidi e tracciamento più stabile. Puoi aggiungerli in un secondo momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕上がりがより鮮明になり、顔の追跡も安定します。あとから追加することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결과가 더 선명해지고 추적도 더 안정적입니다. 나중에 추가할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultados mais nítidos e rastreamento mais estável. Você pode adicionar isso depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结果更清晰，跟踪更稳定。也可以稍后再添加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结果更清晰，跟踪更稳定。也可以稍后再添加。"
          }
        }
      }
    },
    "Sharper skin and eyes. Slower." : {
      "extractionState" : "manual",
