    "Almost half the library, and swapping keeps working without it. You lose steadier tracking, the sharper result, and hands crossing the face staying in front." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast die Hälfte der Modelldaten, und der Gesichtstausch funktioniert auch ohne. Du verlierst die stabilere Verfolgung und das schärfere Ergebnis, und Hände vor dem Gesicht bleiben nicht mehr davor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost half the library, and swapping keeps working without it. You lose steadier tracking, the sharper result, and hands crossing the face staying in front."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi la mitad de todo lo instalado, y el intercambio sigue funcionando sin ello. Pierdes el seguimiento más estable, el resultado más nítido y que las manos que cruzan por delante del rostro se mantengan al frente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presque la moitié de la bibliothèque, et l’échange continue de fonctionner sans eux. Vous perdez la stabilité du suivi, le rendu plus net, et les mains qui passent devant le visage ne restent plus au premier plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quasi metà della libreria dei modelli, e lo scambio continua a funzionare senza. Perdi il tracciamento più stabile, il risultato più nitido e le mani che passano davanti al volto restando in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリのほぼ半分を占めます。削除しても入れ替えは動作しますが、追跡の安定性、細部の鮮明さ、顔の前の手や髪の保持が失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리의 거의 절반입니다. 제거해도 교체는 작동하지만 추적 안정성, 디테일, 얼굴을 가리는 손과 머리카락의 보존이 사라집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É quase metade da biblioteca, e a troca de rostos continua funcionando sem ela. Você perde o rastreamento mais estável, o resultado mais nítido e a proteção das mãos que cruzam o rosto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型库近一半的内容，移除后换脸仍可运行，但会失去跟踪稳定性、细节清晰度，以及对遮挡面部的手和头发的保护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型庫近一半的內容，移除後換臉仍可執行，但會失去追蹤穩定性、細節清晰度，以及對遮擋臉部的手和頭髮的保護。"
          }
        }
      }
    },
    "An export is running. Models cannot be removed until it finishes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Export läuft. Modelle können erst danach entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An export is running. Models cannot be removed until it finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una exportación en curso. No se pueden eliminar los modelos hasta que termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une exportation est en cours. Les modèles ne peuvent pas être supprimés avant la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso un'esportazione. Non puoi rimuovere i modelli finché non termina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出し中です。完了するまでモデルは削除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보내기가 진행 중입니다. 완료될 때까지 모델을 제거할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma exportação está em andamento. Os modelos não podem ser removidos até ela terminar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
