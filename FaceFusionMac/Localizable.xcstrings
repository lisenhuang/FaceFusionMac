    "Almost half the library, and swapping keeps working without it. You lose steadier tracking, the sharper result, and hands crossing the face staying in front." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost half the library, and swapping keeps working without it. You lose steadier tracking, the sharper result, and hands crossing the face staying in front."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリのほぼ半分を占めます。削除しても入れ替えは動作しますが、追跡の安定性、細部の鮮明さ、顔の前の手や髪の保持が失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리의 거의 절반입니다. 제거해도 교체는 작동하지만 추적 안정성, 디테일, 얼굴을 가리는 손과 머리카락의 보존이 사라집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型库近一半的内容，移除后换脸仍可运行，但会失去跟踪稳定性、细节清晰度，以及对遮挡面部的手和头发的保护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型庫近一半的內容，移除後換臉仍可執行，但會失去追蹤穩定性、細節清晰度，以及對遮擋臉部的手和頭髮的保護。"
          }
        }
      }
    },
    "An export is running. Models cannot be removed until it finishes." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An export is running. Models cannot be removed until it finishes."
