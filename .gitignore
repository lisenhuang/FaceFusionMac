# Build output
build/
dist/
DerivedData/
.spm-cache/
*.xcarchive
*.dmg
*.zip

# Xcode user state
xcuserdata/
*.xcuserdatastate
*.xcscmblueprint

# Signing material - never commit these
*.p12
*.p8
*.cer
*.provisionprofile

# ExportOptions.plist is deliberately NOT ignored: it holds no secret (a team ID
# is public, it appears in every signed binary) and the documented export
# command refers to it by name.

# macOS
.DS_Store

# The strings check builds into its own DerivedData path.
.strings-check/
